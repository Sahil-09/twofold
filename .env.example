MONGODB_URI=
MONGODB_DB=twofold

# Optional. When unset, sessions live in Mongo and user reads are uncached.
REDIS_URL=redis://127.0.0.1:6379

# Two accounts, one per person. Format: email:password:Display Name
SEED_USER_A=
SEED_USER_B=

# Web push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects /api/cron/price
CRON_SECRET=
ZENROWS_API_KEY=
